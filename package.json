{
  "name": "themor-shopping-mall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-wizard.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "prestart": "npm run build",
    "start": "node server/index.mjs --production",
    "db:check": "node server/db-cli.mjs check",
    "db:setup": "node server/db-cli.mjs setup",
    "db:query": "node server/db-cli.mjs query",
    "db:report": "node server/db-cli.mjs report",
    "test:api": "node --test server/tests/*.test.mjs",
    "test:db": "node server/tests/integration.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "motion": "^14.9.1",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
